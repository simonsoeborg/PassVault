{
  "name": "passvault",
  "productName": "PassVault",
  "version": "0.1.0-rc.8",
  "description": "A local-first, cross-platform password vault for technical people.",
  "private": true,
  "main": "./out/main/index.js",
  "author": "PassVault",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "web:mock": "vite --config vite.mock.config.ts",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "smoke": "node scripts/smoke.mjs",
    "capture": "node scripts/capture.mjs",
    "icons": "node --no-warnings scripts/icons.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "diceware-wordlist-en-eff": "^1.0.1",
    "hash-wasm": "^4.12.0",
    "kdbxweb": "^2.1.1",
    "sshpk": "^1.18.0"
  },
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sshpk": "^1.17.5",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.44.0",
    "playwright-core": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~5.9",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
